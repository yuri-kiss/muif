{
  "name": "yuri-kiss-muif",
  "version": "0.1.0",
  "description": "Simple library/framework by Miyo Sho.",
  "keywords": [
    "ui",
    "library",
    "framework"
  ],
  "author": {
    "email": "yri5@duck.com",
    "name": "Miyo Sho",
    "url": "https://github.com/yuri-kiss/"
  },
  "homepage": "https://github.com/yuri-kiss/muif/#README-v0",
  "readme": "https://github.com/yuri-kiss/muif/#README-v0",
  "bugs": {
    "url": "https://github.com/yuri-kiss/muif/issues/"
  },
  "repository": {
    "directory": "/",
    "type": "git",
    "url": "git+https://github.com/yuri-kiss/muif.git"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24.15.0"
    },
    "os": {
      "name": "linux",
      "onFail": "ignore"
    }
  },
  "license": "LGPL-2.1-only",
  "type": "commonjs",
  "main": "./dist/node.umd.min.js",
  "browser": "./dist/browser.umd.min.js",
  "scripts": {
    "test": "cross-env mocha",
    "check:format": "cross-env prettier --config .prettierrc.yaml --check \"./**/*.cjs\"",
    "build": "cross-env NODE_ENV=\"development\" && webpack",
    "build:prod": "cross-env NODE_ENV=\"production\" && webpack",
    "build:dev": "yarn run build",
    "format": "cross-env prettier  --config .prettierrc.yaml --write \"./**/*.cjs\"",
    "ncu": "cross-env ncu -u"
  },
  "sideeffects": [],
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@swc/core": "^1.15.26",
    "@types/node": "^25.6.0",
    "@types/webpack": "^5.28.5",
    "babel-loader": "^10.1.1",
    "babel-plugin-transform-define": "^2.1.4",
    "chai": "^6.2.2",
    "chai-as-promised": "npm:chai-as-promised",
    "core-js-pure": "^3.49.0",
    "cross-env": "^10.1.0",
    "jsdom": "^29.0.2",
    "mocha": "^11.7.5",
    "npm-check-updates": "npm:npm-check-updates",
    "prettier": "^3.8.3",
    "raw-loader": "npm:raw-loader",
    "swc-minify-webpack-plugin": "^2.1.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3",
    "yarn": "^1.22.22"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "^7.29.2",
    "google-closure-library": "npm:google-closure-library",
    "regenerator-runtime": "^0.14.1"
  }
}
